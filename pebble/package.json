{
  "name": "findmy-for-pebble-watchapp",
  "version": "0.2.0",
  "private": true,
  "author": "Alex Tsalyuk",
  "description": "Find My for Pebble — ping your Apple devices from your wrist.",
  "license": "MIT",
  "scripts": {
    "deps:local": "npm install --workspaces=false",
    "build": "tsc -p tsconfig.json && node ./tools/transpile-src.mjs",
    "bundle": "sh ./tools/pebble-bundle.sh",
    "install:aplite": "sh ./tools/pebble-bundle.sh && pebble install --emulator aplite --logs",
    "install:basalt": "sh ./tools/pebble-bundle.sh && pebble install --emulator basalt --logs",
    "install:chalk": "sh ./tools/pebble-bundle.sh && pebble install --emulator chalk --logs",
    "install:diorite": "sh ./tools/pebble-bundle.sh && pebble install --emulator diorite --logs",
    "install:emery": "sh ./tools/pebble-bundle.sh && pebble install --emulator emery --logs",
    "install:flint": "sh ./tools/pebble-bundle.sh && pebble install --emulator flint --logs",
    "install:gabbro": "sh ./tools/pebble-bundle.sh && pebble install --emulator gabbro --logs",
    "settings:preview": "npm run build && node ./tools/settings-preview.mjs"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.8",
    "bn.js": "^5.2.3",
    "core-js": "^3.46.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "pebble-app"
  ],
