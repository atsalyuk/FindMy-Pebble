{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src-ts",
    "outDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES5",
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "src-ts/**/*.ts",
    "src-ts/**/*.d.ts"
  ]
}
